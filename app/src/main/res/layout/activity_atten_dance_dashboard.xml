<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/dlMain"
    tools:context=".activity.attendance.AttenDanceDashboardActivity"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?android:actionBarSize"
            android:orientation="horizontal"
            android:background="@mipmap/bottom_menu">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginLeft="10dp"
                    android:src="@drawable/menu_bar"
                    app:tint="@color/white"
                    android:id="@+id/imgMenu"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attendance"

                    android:textSize="@dimen/toolbartextsize"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:gravity="right">
                <ImageView
                    android:visibility="gone"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="15dp"
                    android:src="@drawable/searchicon"
                    android:id="@+id/imgSearch"/>
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginRight="15dp"
                    android:src="@drawable/home_new"
                    android:id="@+id/imgHome"/>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout

                    android:visibility="gone"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <LinearLayout
                        android:weightSum="7"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/blue">
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Sun"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Mon"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Tue"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Wed"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Thu"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Fri"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                        <TextView
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:text="Sat"
                            android:textStyle="bold"
                            android:layout_gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"></TextView>
                    </LinearLayout>
                    <LinearLayout
                        android:weightSum="7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvSun"></androidx.recyclerview.widget.RecyclerView>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvMon"></androidx.recyclerview.widget.RecyclerView>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvTue"></androidx.recyclerview.widget.RecyclerView>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvWed"></androidx.recyclerview.widget.RecyclerView>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvThu"></androidx.recyclerview.widget.RecyclerView>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvFri"></androidx.recyclerview.widget.RecyclerView>
                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:id="@+id/rvSat"
                           ></androidx.recyclerview.widget.RecyclerView>


                    </LinearLayout>
                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView

                    android:visibility="gone"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:id="@+id/rvItem"></androidx.recyclerview.widget.RecyclerView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/blue"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.3"
                        android:gravity="bottom|center"
                        android:layout_marginLeft="16dp">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/attcalendar"></ImageView>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|right"
                        android:padding="5dp"
                        android:layout_marginLeft="20dp"
                        android:layout_marginRight="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:text="Present"></TextView>
                        <TextView
                            android:textStyle="bold"
                            android:layout_marginLeft="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="30sp"
                            android:textColor="@color/white"
                            android:id="@+id/tvPresent"></TextView>
                        <TextView
                            android:layout_marginLeft="10dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="@color/white"
                            android:text="Days"></TextView>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:elevation="7dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/background_17">

                    <TextView
                        android:id="@+id/txtAttendanceDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ATTENDANCE DETAILS"
                        android:textSize="13sp"
                        android:textColor="@color/text_color_3"
                        android:fontFamily="@font/open_sans_bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:weightSum="3">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Present Day"
                                android:textSize="12sp"
                                android:fontFamily="@font/open_sans_semi_bold"/>
                            <TextView
                                android:id="@+id/txtPresentDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="17sp"
                                android:fontFamily="@font/open_sans_bold"
                                android:textColor="@color/pink1"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Absent Day"
                                android:textSize="12sp"
                                android:fontFamily="@font/open_sans_semi_bold"/>
                            <TextView
                                android:id="@+id/txtAbsentDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="17sp"
                                android:fontFamily="@font/open_sans_bold"
                                android:textColor="@color/pink1"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Holiday"
                                android:textSize="12sp"
                                android:fontFamily="@font/open_sans_semi_bold"/>
                            <TextView
                                android:id="@+id/txtHolidayDay"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="17sp"
                                android:fontFamily="@font/open_sans_bold"
                                android:textColor="@color/pink1"/>

                        </LinearLayout>


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Leave Taken"
                                android:textSize="12sp"
                                android:fontFamily="@font/open_sans_semi_bold"/>
                            <TextView
                                android:id="@+id/txtLeaveTaken"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="17sp"
                                android:fontFamily="@font/open_sans_bold"
                                android:textColor="@color/pink1"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Weekly Off"
                                android:textSize="12sp"
                                android:fontFamily="@font/open_sans_semi_bold"/>
                            <TextView
                                android:id="@+id/txtWeeklyOff"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="17sp"
                                android:fontFamily="@font/open_sans_bold"
                                android:textColor="@color/pink1"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Optional Holiday"
                                android:textSize="12sp"
                                android:fontFamily="@font/open_sans_semi_bold"/>
                            <TextView
                                android:id="@+id/txtOptionalHoliday"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="17sp"
                                android:fontFamily="@font/open_sans_bold"
                                android:textColor="@color/pink1"/>
                        </LinearLayout>
                    </LinearLayout>





                </LinearLayout>


                <org.naishadhparmar.zcustomcalendar.CustomCalendar
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/custom_calendar"
                    android:layout_marginHorizontal="10dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom|right">

                        <LinearLayout
                            android:id="@+id/llBottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/lldesign"
                            android:orientation="vertical"
                            android:padding="5dp"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/llAttenRegularize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:src="@drawable/backdate_attendance"></ImageView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="5dp"
                                    android:text="Regularize your Attendance"
                                    android:textColor="@color/textcolor"
                                    android:textSize="14sp"></TextView>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvCancel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:gravity="right"
                                android:text="CLOSE"
                                android:textColor="@color/textcolor"
                                android:textSize="14sp"
                                android:textStyle="bold"></TextView>
                        </LinearLayout>
                    </LinearLayout>


                </io.cordova.myapp00d753.customcalender.CustomCalendar>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                   >
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/green"
                            android:layout_gravity="center">

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/black"
                        android:layout_gravity="center"
                        android:layout_marginStart="2dp"
                        android:text="PRESENT"
                        android:fontFamily="@font/open_sans_bold"/>

                    <LinearLayout
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/misscolor"
                            android:layout_gravity="center">



                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginStart="2dp"
                        android:text="ABSENT"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>


                    <LinearLayout
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/half_day"
                            android:layout_gravity="center">



                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginStart="2dp"
                        android:text="HALF DAY"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>

                    <LinearLayout
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/blue"
                            android:layout_gravity="center">



                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginRight="2dp"
                        android:layout_marginLeft="2dp"
                        android:text="WEEKLY OFF"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>




                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/optional_holiday"
                            app:cardCornerRadius="4dp">

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:text="OPTIONAL HOLIDAY"
                        android:textSize="10sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:layout_margin="4dp"
                            app:cardBackgroundColor="@color/contactcolor"
                            app:cardCornerRadius="4dp">


                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginLeft="2dp"
                        android:text="LEAVE"
                        android:textSize="10sp"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>

                    <LinearLayout
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_marginStart="2dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/nessecarycolor"
                            android:layout_gravity="center">



                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView
                        android:layout_marginRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:text="HOLIDAY"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp"
                    android:gravity="center">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_margin="4dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/weekly_comp_off"
                            android:layout_gravity="center">

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="2dp"
                        android:text="WEEKLY COMP OFF"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>

                    <LinearLayout
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_marginStart="2dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/holiday_work"
                            android:layout_gravity="center">

                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginStart="3dp"
                        android:text="HOLIDAY WORK"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>
                    <LinearLayout
                        android:layout_marginStart="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="17dp"
                            android:layout_height="9dp"
                            android:layout_marginStart="2dp"
                            app:cardCornerRadius="4dp"
                            app:cardBackgroundColor="@color/purple"
                            android:layout_gravity="center">



                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                    <TextView
                        android:layout_marginRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:text="HALF DAY LEAVE"
                        android:fontFamily="@font/open_sans_bold"
                        android:textColor="@color/black"/>
                </LinearLayout>






                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center">
                    <TextView
                        android:layout_marginRight="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textColor="@color/designcolor1"
                        android:layout_gravity="center"
                        android:layout_marginLeft="5dp"
                        android:fontFamily="@font/open_sans_bold"
                        android:text="Note : Please click on the date for more details"></TextView>

                </LinearLayout>

                <LinearLayout
                    android:layout_marginRight="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="10dp">
                    <Button
                        android:id="@+id/btnMarkAttendance"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:text="Mark Attendance"
                        android:background="@drawable/lldesign"
                        android:backgroundTint="@color/pink1"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/open_sans_semi_bold"
                        android:layout_weight="1"/>
                    <Button
                        android:layout_marginLeft="10dp"
                        android:id="@+id/btnLeave"
                        android:textSize="14sp"
                        android:textColor="@color/pink1"
                        android:text="Apply for Leave"
                        android:background="@drawable/background_30"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:textAllCaps="false"
                        android:fontFamily="@font/open_sans_semi_bold"
                        android:layout_weight="1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom">

                    <LinearLayout
                        android:id="@+id/lnStatus"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@color/white"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvDetails"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:layout_weight="1"
                            android:textColor="@color/white"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tvOK"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:layout_weight="0.1"
                            android:text="OK"
                            android:textColor="@color/white"
                            android:textSize="14sp"></TextView>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
    <include
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:id="@+id/llDrawerPane"
        layout="@layout/new_attendance_drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="30dp"
        android:layout_gravity="left"
        android:fitsSystemWindows="false"
        android:focusableInTouchMode="false"/>

</androidx.drawerlayout.widget.DrawerLayout>