                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:background="@drawable/background_32"
                            app:cornerRadius="14dp"
                            app:rippleColor="#40B343C7"
                            app:strokeColor="#B343C7"
                            app:strokeWidth="2dp" />



                        <Button
