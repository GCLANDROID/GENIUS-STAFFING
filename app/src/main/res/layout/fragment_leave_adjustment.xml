<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.LeaveAdjustmentFragment"
    android:orientation="vertical"
    android:padding="10dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:background="@drawable/background_15">

            <TextView
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_medium"
                android:textColor="@color/pink1"
                android:text="Financial Year"
                android:textSize="13sp"/>
            <LinearLayout
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/background_17">
                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/spFinYear"/>
            </LinearLayout>

            <TextView
                android:layout_marginTop="10dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_medium"
                android:textColor="@color/pink1"
                android:text="Month"
                android:textSize="13sp"/>
            <LinearLayout
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/background_17">
                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:id="@+id/spMonth"/>
            </LinearLayout>
            <Button
                android:visibility="visible"
                android:id="@+id/btnShow"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/lldesign"
                android:backgroundTint="@color/pink1"
                android:text="Show"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:layout_marginBottom="15dp"/>

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/rvItem"
            android:visibility="gone"/>
        <TextView
            android:layout_marginTop="30dp"
            android:textAlignment="center"
            android:id="@+id/tvNoData"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/text_color_3"
            android:layout_gravity="center"
            android:fontFamily="@font/open_sans_bold"
            android:text="No Application(s) found on Selected Month"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.1"
        android:gravity="center"
        android:padding="10dp">
        <LinearLayout
            android:layout_gravity="center"
            android:id="@+id/lnAddApplication"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:background="@drawable/lldesign"
            android:backgroundTint="@color/text_color_3"
            android:gravity="center">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/addimg"
                app:tint="@color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:layout_marginLeft="5dp"
                android:text="Add Application"/>
        </LinearLayout>
    </LinearLayout>



</LinearLayout>