<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout3"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@mipmap/group_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="35dp"
        android:src="@drawable/arrow_left_new"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imgHome"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="35dp"
        android:src="@drawable/home_new"
        android:layout_marginEnd="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvToolBar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="25dp"
        android:background="@color/white"
        android:fontFamily="@font/open_sans_semi_bold"
        android:gravity="center"
        android:text="Leave Application"
        android:textColor="@color/new_header_text_color"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@+id/imgBack" />

    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout17"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvToolBar" />

    <LinearLayout
        android:id="@+id/linearLayout17"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_weight="0.1"
        android:orientation="horizontal"
        android:background="@mipmap/bottom_menu"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/llApplication"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimaryDark"
            android:gravity="center"
            android:orientation="vertical">

            <!--<ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/leave_application"/>-->

            <TextView
                android:id="@+id/tvApllication"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:text="Leave Application"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/background_19"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <LinearLayout

            android:id="@+id/llDetails"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="14sp"/>
            <View
                android:id="@+id/view2"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:background="@drawable/background_19"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llApproval"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvApproval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leave \nApproval"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="13sp"/>

            <View
                android:id="@+id/view3"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:background="@drawable/background_19"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llAdjustment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAdjustment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leave \nAdjustment"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="13sp"/>

            <View
                android:id="@+id/view4"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:background="@drawable/background_19"
                android:backgroundTint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLeaveBalanceReport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvLeaveBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leave Balance"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="13sp"/>

            <View
                android:id="@+id/view5"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginHorizontal="5dp"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:background="@drawable/background_19"
                android:backgroundTint="@color/white" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
