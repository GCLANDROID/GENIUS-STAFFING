<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:layout_marginTop="15sp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/background_17"
        android:backgroundTint="#ab4dc1"
        android:orientation="horizontal"
        android:elevation="5dp">
        <TextView
            android:gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:layout_weight="0.5"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"/>
        <TextView
            android:gravity="center"
            android:layout_marginLeft="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="In time"
            android:layout_weight="0.5"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"/>
        <TextView
            android:gravity="center"
            android:layout_marginLeft="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Out time"
            android:layout_weight="0.5"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"/>
        <TextView
            android:layout_marginRight="2dp"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day Type"
            android:layout_weight="0.2"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="5dp"

        android:layout_marginRight="5dp"
        android:orientation="horizontal"
        >
        <LinearLayout
            android:visibility="visible"
            android:id="@+id/llLike"
            android:gravity="center"
            android:background="@drawable/lldesign"
            android:layout_gravity="center"
            android:backgroundTint="@color/grey"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_weight="0.1">
            <ImageView
                android:visibility="gone"
                android:id="@+id/imgLike"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/likeicon"
                app:tint="@color/white"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center"
            android:text="02/09/2020"
            android:textColor="@android:color/black"
            android:fontFamily="@font/open_sans_regular"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvInTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="5dp"
                android:gravity="center"
                android:text="09:00"
                android:textColor="@android:color/black"
                android:fontFamily="@font/open_sans_regular"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/imgInTime"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginLeft="5dp"
                android:src="@drawable/clock_3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOutTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="5dp"
                android:gravity="center"
                android:text="17:30"
                android:textColor="@android:color/black"
                android:fontFamily="@font/open_sans_regular"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/imgOutTime"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:layout_marginLeft="5dp"
                android:src="@drawable/clock_3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDayType"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:layout_weight="0.2"
            android:gravity="center"
            android:text="Daytype"
            android:textColor="@android:color/black"
            android:fontFamily="@font/open_sans_regular"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/txtRemarks"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:textSize="13dp"
            android:layout_marginBottom="5dp"
            android:textColor="#000000"
            android:fontFamily="@font/open_sans_regular"
            tools:text="Regularisation Request Already Exists...Further Request Not Allowed!"/>
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ddb8e6"
        android:layout_marginHorizontal="5dp">

        <EditText
            android:id="@+id/edtRemarks"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginStart="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/background_17"
            android:hint="Remarks"
            android:paddingStart="15dp"
            android:paddingEnd="10dp"
            android:textSize="11.5sp"
            android:fontFamily="@font/open_sans_regular"/>

        <TextView
            android:id="@+id/tvShift"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:layout_weight="0.2"
            android:gravity="left|center"
            android:lines="3"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="10dp"
            android:paddingStart="15dp"
            android:paddingEnd="10dp"
            android:background="@drawable/background_17"
            android:hint="Select Shift"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            android:drawableTint="@color/pink1"
            android:drawableEnd="@drawable/ic_arrow_drop_down_24"
            android:fontFamily="@font/open_sans_regular"/>

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:layout_weight="0.2"
            android:gravity="left|center"
            android:lines="3"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="10dp"
            android:paddingStart="15dp"
            android:paddingEnd="10dp"
            android:drawableTint="@color/pink1"
            android:background="@drawable/background_17"
            android:hint="Select Location"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            android:drawableEnd="@drawable/ic_arrow_drop_down_24"/>

        <TextView
            android:id="@+id/tvApprover"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:layout_weight="0.2"
            android:gravity="left|center"
            android:lines="3"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="15dp"
            android:layout_marginTop="10dp"
            android:paddingStart="15dp"
            android:paddingEnd="10dp"
            android:drawableTint="@color/pink1"
            android:background="@drawable/background_17"
            android:hint="Select Approvar"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans_regular"
            android:drawableEnd="@drawable/ic_arrow_drop_down_24"/>

    </LinearLayout>




</LinearLayout>
