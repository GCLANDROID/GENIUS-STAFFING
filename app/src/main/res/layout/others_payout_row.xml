<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/background_19">

        <TextView
            android:id="@+id/tvBillType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_weight="0.5"
            android:fontFamily="@font/open_sans_regular"
            android:text="Bill Type"
            android:textAlignment="center"
            android:textColor="@color/text_color_5"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/pink1" />

        <TextView
            android:id="@+id/tvYear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_weight="0.5"
            android:fontFamily="@font/open_sans_regular"
            android:text="Payable \nYear"
            android:textAlignment="center"
            android:textColor="@color/text_color_5"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/pink1" />

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_weight="0.5"
            android:fontFamily="@font/open_sans_regular"
            android:text="Payable \nMonth"
            android:textAlignment="center"
            android:textColor="@color/text_color_5"
            android:textSize="13sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/pink1" />

        <TextView
            android:id="@+id/tvAmt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_weight="0.5"
            android:fontFamily="@font/open_sans_regular"
            android:text="Disbursed \nAmt."
            android:textAlignment="center"
            android:textColor="@color/text_color_5"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>

