<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@mipmap/new_login_background"
    android:fitsSystemWindows="true"
    android:layout_marginStart="-2dp"
    android:layout_marginEnd="-2dp"
    tools:context="io.cordova.myapp00d753.activity.LoginActivity">

    <ImageView
        android:id="@+id/imgCompanyLogo"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:src="@drawable/geniuslogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        app:tint="@color/white" />

    <LinearLayout
        android:id="@+id/llMainOption"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="25dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:weightSum="2"
        android:paddingHorizontal="15dp"
        app:layout_constraintTop_toBottomOf="@+id/imgCompanyLogo">
        <LinearLayout
            android:id="@+id/clSelfService"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginVertical="8dp"
            android:background="@drawable/button_background_2"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconSelfService"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/self_service_white_icon"/>
            <TextView
                android:id="@+id/txtSelfService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Self-Service"
                android:textSize="13sp"
                android:textColor="@color/white"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/clPaperlessOnboarding"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginVertical="7dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iconPaperlessOnboarding"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/paperless_1"/>
            <TextView
                android:id="@+id/txtPaperlessOnboarding"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Paperless Onboarding"
                android:textSize="13sp"
                android:textColor="@color/grey"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSubOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingBottom="20dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/background_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/llMainOption">

        <LinearLayout
            android:id="@+id/llLC"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/border_background_2">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/authentication_1"
                android:layout_weight=".2"
                android:padding="8dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Login with Credentials"
                android:layout_weight="1.6"
                android:textColor="@color/black"/>

            <ImageView
                android:id="@+id/LCTick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/elipse_check"
                android:layout_weight=".2"
                android:elevation="30dp"
                android:padding="7dp"/>
        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/llLM"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/border_background_3">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/login_1"
                android:layout_weight=".2"
                android:padding="8dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Login with Mobile OTP"
                android:textColor="@color/black"
                android:layout_weight="1.6"/>

            <ImageView
                android:id="@+id/LMTick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/ellipse"
                android:layout_weight=".2"
                android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llEP"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/border_background_3">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/latter_e"
                android:layout_weight=".2"
                android:padding="8dp"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Login with E-PIN"
                android:textColor="@color/black"
                android:layout_weight="1.6"/>
            <ImageView
                android:id="@+id/EPTick"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/ellipse"
                android:layout_weight=".2"
                android:padding="8dp"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@+id/llSubOption" />


