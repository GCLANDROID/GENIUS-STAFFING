<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llLoginCredentials"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#f4e1fc"
    android:paddingBottom="15dp"
    android:paddingHorizontal="15dp"
    tools:context=".fragment.LoginCredentialsFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter User ID"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="15dp"
        android:textColor="@color/black"/>

    <EditText
        android:id="@+id/etUserId"
        android:singleLine="true"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:paddingStart="15dp"
        android:background="@drawable/solid_gray_background"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Password"
        android:textSize="13sp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:textColor="@color/black"/>

    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/solid_gray_background">
        <EditText
            android:inputType="textPassword"
            android:imeOptions="actionNext"
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:textSize="14sp"
            android:paddingStart="15dp"
            android:singleLine="true"
            android:layout_weight="1"
            />
        <FrameLayout
            android:visibility="visible"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgVisible"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/show"
                ></ImageView>
            <ImageView

                android:id="@+id/imginVisible"
                android:visibility="gone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/hide"></ImageView>
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSecurityCode"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter Security Code"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:textColor="@color/black"/>

        <EditText
            android:id="@+id/etSecuritycode"
            android:singleLine="true"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:textSize="14sp"
            android:paddingStart="15dp"
            android:background="@drawable/solid_gray_background"/>
    </LinearLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <CheckBox
            android:id="@+id/ckRemember"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:text="Remember Me"
            android:textStyle="bold"
            android:textColor="@color/text_color_3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/llForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:text="Forgot Password"
            android:textColor="@color/text_color_3"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <Button
        android:id="@+id/llSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:background="@drawable/button_background_2"
        android:layout_marginTop="10dp"
        android:textColor="@color/white"
        android:layout_marginBottom="10dp"/>

</LinearLayout>