                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_marginBottom="5dp"
                android:visibility="visible"
                android:layout_gravity="bottom|right"
                android:id="@+id/chatFabContainer"
                android:layout_width="wrap_content"
